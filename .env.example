# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Разрешённые Telegram user ID через запятую (узнать свой: напиши боту @userinfobot).
# Только эти пользователи смогут вызывать /add.
ADMIN_IDS=111111111,222222222

# Имя docker-контейнера AmneziaWG (по умолчанию amnezia-awg).
CONTAINER=amnezia-awg

# Публичный адрес точки входа (IP или домен), обязателен для /add.
# Для двух VPS: адрес российского ретранслятора, бот остаётся на зарубежном VPS.
ENDPOINT_HOST=

# Публичный UDP-порт точки входа. Пусто = ListenPort AmneziaWG.
# Для ретранслятора задаётся entry.port из deploy/two-vps.json.
ENDPOINT_PORT=

# DNS, которые пропишутся клиенту.
DNS1=1.1.1.1
DNS2=1.0.0.1

# Подпись/описание сервера, видимое в приложении при импорте.
SERVER_DESCRIPTION=My Amnezia VPN
